{
  "name": "waktos",
  "version": "5.0.0",
  "description": "~4kB for the death of ugly dates!",
  "keywords": [
    "waktos"
  ],
  "homepage": "https://github.com/fauziralpiandi/waktos#readme",
  "bugs": {
    "url": "https://github.com/fauziralpiandi/waktos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fauziralpiandi/waktos.git"
  },
  "license": "MIT",
  "author": "Fauzira Alpiandi <fauziralpiandi.dev@gmail.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugin/*": {
      "types": "./dist/plugin/*.d.ts",
      "import": "./dist/plugin/*.mjs",
      "require": "./dist/plugin/*.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup && size-limit",
    "format": "prettier --write .",
    "lint": "eslint --fix src tests",
    "prepublishOnly": "pnpm build",
    "test": "vitest --run"
  },
  "browserslist": [
    "Chrome >= 84",
    "Firefox >= 84",
    "Safari >= 14.1",
    "Edge >= 84",
    "iOS >= 14.5",
    "Android >= 84",
    "Samsung >= 14",
    "not IE 11",
    "not dead",
    "not op_mini all"
  ],
  "prettier": {
    "bracketSpacing": true,
    "trailingComma": "none"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@fauziralpiandi/eslint-config": "^2.0.0",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "4.99 kB"
    },
    {
      "path": "dist/**/*.mjs"
    }
  ]
}
